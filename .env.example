# SANJI environment configuration — copy to .env.local and fill in.
#
# Environment separation (dev / staging / prod) per spec §17. The same build
# artifact is promoted across environments; behaviour differs only by these
# values. NEVER commit a filled-in copy of this file (see .gitignore).

# ---------------------------------------------------------------------------
# Environment selector. One of: development | staging | production
# Drives src/config/runtime.ts. Anything else fails fast at boot (fail loud).
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Database / Auth — Postgres (Supabase), RLS for tenancy (§16.1)
# Use a DISTINCT project per environment. RLS is enforced in the DB; the
# service-role key bypasses RLS and MUST only be used by trusted server code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Object storage — S3-compatible (logos, generated PDFs) (§17)
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# LLM provider — provider-abstracted, server-side only (§8.1).
# Business logic MUST NOT couple to any vendor SDK; all calls go through the
# provider interface in src/llm/provider.ts. Student PII is NEVER sent (§16.2).
# LLM_PROVIDER selects the adapter; keys are per-provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Rendering — headless Chromium in a dedicated warm container, NOT serverless
# (§17, §9). Rendering proceeds against a clearly-marked placeholder font
# (§9.2); the licensed 教科書体 is BLOCKED on the Morisawa license, which
# gates LAUNCH (§19.1/§21) — the placeholder must never reach a pilot juku
# or a parent.
# ---------------------------------------------------------------------------
RENDER_SERVICE_URL=

# ---------------------------------------------------------------------------
# §7.10 runtime configuration overrides (all optional; validated at boot —
# invalid values throw rather than being silently clamped). Selection shown
# here; see src/config/runtime.ts for the full list and defaults.
# ---------------------------------------------------------------------------
# 常用 extension characters admitted into allowed_with_ruby on top of the
# 1,026 kyōiku base set (§7.2). Plain string of characters, no separators.
SANJI_ALLOWED_WITH_RUBY_EXTENSIONS=
# Default org ruby_policy: conservative | always | minimal (§9.6).
SANJI_RUBY_POLICY_DEFAULT=
# Conservative-policy grade boundary, integer 1..6, default 3 (§9.6, §19.5).
SANJI_RUBY_GRADE_BOUNDARY=
